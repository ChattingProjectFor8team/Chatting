# `.env.example` 을 `.env` 로 복사해서 사용한다.
# 실제 `.env` 파일은 커밋하지 않는다.
#
# 로컬 기본 실행은 `application-local.yml` 기준이다.
# - MySQL: `localhost:33306 / springchatting`
# - Redis: `localhost:6380`
# 따라서 로컬에서는 DB URL/계정 환경변수를 따로 넣지 않아도 된다.

# =============================
# Spring Profile
# =============================
SPRING_PROFILES_ACTIVE=local

# =============================
# Required / Common
# =============================
# JWT 시크릿은 Base64 인코딩된 32바이트 이상 값을 권장한다.
# 생성 예시: `openssl rand -base64 32`
JWT_SECRET_KEY=replace-with-your-base64-jwt-secret

# 로컬에서는 더미 값으로도 부팅 가능하다.
PORTONE_API_SECRET=test_dummy_secret_for_local
PORTONE_WEBHOOK_SECRET=test_dummy_webhook_secret_for_local

# YouTube import 기능을 실제로 검증할 때만 넣는다.
YOUTUBE_DATA_API_KEY=

# =============================
# AWS credentials / legacy fallback
# =============================
# media.storage.* 가 우선이고, 아래 값은 AWS SDK 기본 credential chain 또는 레거시 fallback 용도로만 남긴다.
AWS_ACCESS_KEY_ID=dummy-local-access-key
AWS_SECRET_ACCESS_KEY=dummy-local-secret-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=dummy-local-bucket
CLOUDFRONT_DOMAIN=http://localhost:8080

# =============================
# Optional: media storage
# =============================
# 기본 로컬 실행은 false 권장.
MEDIA_STORAGE_ENABLED=false
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=ap-northeast-2
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_PUBLIC_BASE_URL=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_PATH_STYLE_ACCESS=false
MEDIA_STORAGE_KEY_PREFIX=post-media

# =============================
# Production / deploy only
# =============================
# `prod` 프로파일에서 사용하는 값들이다.
# MEDIA_STORAGE_BUCKET 을 비워두면 현재는 S3_BUCKET_NAME 값을 media bucket fallback 으로도 읽는다.
RDS_HOST=
RDS_USERNAME=
RDS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
S3_BUCKET_NAME=
APP_SEED_SHOWCASE_DATA=false
APP_SEED_SHOWCASE_PASSWORD=demo1234!


# Grafana Local Settings (DO NOT USE admin/admin in production)
GRAFANA_ADMIN_USER=your_admin_username_here
GRAFANA_ADMIN_PASSWORD=your_admin_password_here
